{
  "name": "api.littleeleven.com",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "postinstall": "prisma generate && node scripts/fix-prisma-runtime-paths.js",
    "start:local": "wrangler dev --port 12345",
    "start:remote": "wrangler dev --remote",
    "deploy": "wrangler deploy",
    "wrangler:login": "wrangler login",
    "d1:migrations:diff": "prisma migrate diff --from-migrations ./migrations --to-schema ./prisma/schema.prisma --script --output migrations/0001_init.sql",
    "d1:migrations:deploy-local": "wrangler d1 migrations apply littleeleven --local",
    "d1:migrations:deploy-remote": "wrangler d1 migrations apply littleeleven --remote",
    "d1:export:remote": "wrangler d1 export littleeleven --remote --output=./remote.sql",
    "tsc-check": "tsc --noEmit",
    "lint": "eslint . --fix",
    "unit:test": "vitest --run --exclude tests/e2e",
    "e2e:test": "vitest --run tests/e2e"
  },
  "dependencies": {
    "@hono/oauth-providers": "^0.8.5",
    "@hono/zod-openapi": "^1.2.4",
    "@prisma/adapter-d1": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "dayjs": "^1.11.20",
    "hono": "^4.12.12",
    "zod": "^4.3.6",
    "zod-validation-error": "^5.0.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^8.1.0",
    "@cloudflare/vitest-pool-workers": "^0.14.2",
    "@cloudflare/workers-types": "^4.20260408.1",
    "@types/node": "^25.5.2",
    "cross-env": "^10.1.0",
    "eslint": "^10.2.0",
    "npm-run-all": "^4.1.5",
    "prisma": "^7.7.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.7",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.3",
    "wrangler": "^4.81.0",
    "zod-prisma-types": "^3.3.11"
  }
}
